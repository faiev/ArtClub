  "revision_policy": {
    "field": "expected_revision",
    "required_for": "document_mutating",
    "conflict": {
      "behavior": "reject_without_replay",
      "error_code": "STALE_REVISION",
      "recovery": "Call artclub_get_status, inspect the current document, then decide whether to submit a new operation with the latest revision."
    },
    "concurrency": {
      "within_one_bridge_process": "serialized",
      "across_bridge_processes": "exclusive_profile_lock",
      "automatic_retry": false
    }
  },
  "limits": {
    "max_canvas_width": 512,
    "max_canvas_height": 512,
    "max_layers": 32,
    "max_frames": 256,
    "max_palette_colors": 256,
    "max_total_cel_pixels": 16777216,
    "max_batch_commands": 1000,
    "max_tool_input_bytes": 8388608,
    "max_tool_output_bytes": 16777216,
    "max_pending_operations": 64
  },
  "execution": {
    "default_deadline_ms": 30000,
    "maximum_deadline_ms": 120000,
    "per_tool_deadline_ms": {
      "artclub_get_status": 10000,
      "artclub_get_pixel": 10000,
      "artclub_get_canvas": 30000,
      "artclub_execute": 45000,
      "artclub_save": 30000,
      "artclub_open_project": 60000,
      "artclub_export_project": 45000,
      "artclub_import_project": 90000,
      "artclub_export_png": 25000
    },
    "cancellation": {
      "supported": true,
      "queued_request": "removed_before_execution",
      "active_request": "page_interrupted_and_queue_slot_held_until_evaluation_unwinds",
      "outcome_may_be_uncertain": true,
      "error_codes": [
        "OPERATION_CANCELLED",
        "OPERATION_TIMEOUT",
        "QUEUE_FULL"
      ]
    }
  },
